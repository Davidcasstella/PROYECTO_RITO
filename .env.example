# Variables opcionales para las funciones del servidor (/api). Se configuran en Vercel:
# Project → Settings → Environment Variables. Ninguna es obligatoria.

# Reenvía cada solicitud de reserva (JSON) a esta URL: Make, Zapier, n8n, Google Apps Script…
# Útil para guardar las reservas en una hoja de cálculo o recibir un correo.
RESERVAS_WEBHOOK_URL=

# Lo mismo para los mensajes del formulario de contacto.
CONTACTO_WEBHOOK_URL=
