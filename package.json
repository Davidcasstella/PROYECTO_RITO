{
  "name": "proyecto-rito",
  "private": true,
  "description": "Sitio web de RITO Rooftop · Gastrobar & Terraza (Sogamoso).",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "check": "npm run check --workspace frontend && npm run typecheck:api",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "test": "npm run test --workspace frontend"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
